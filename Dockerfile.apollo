# Apollo base image: libwallet Go sources at the pinned commit.
# scripts/apollo-image.sh builds it once per pin and recipe; Dockerfile and
# Dockerfile.test copy /deps/apollo/libwallet from it.
#
# librs (Rust) is not built: the wrapper never imports
# github.com/muun/libwallet/librs, so nothing links its static library.

ARG APOLLO_COMMIT=e5f5e1bb54f611ef457c56207f2a34ac85b00827

# Same image as the Go build stages, so the fetch reuses it and its git.
FROM golang:1.24-bookworm AS libwallet

WORKDIR /deps/apollo

# Only the pinned commit, and only libwallet.
ARG APOLLO_COMMIT
RUN git init --quiet \
    && git remote add origin https://github.com/muun/apollo.git \
    && git sparse-checkout set --cone libwallet \
    && git fetch --depth 1 --filter=blob:none origin "$APOLLO_COMMIT" \
    && git checkout --quiet --detach FETCH_HEAD \
    && fetched="$(git rev-parse HEAD)" \
    && if [ "$fetched" != "$APOLLO_COMMIT" ]; then echo "fetched $fetched, expected $APOLLO_COMMIT" >&2; exit 1; fi \
    && echo "apollo $fetched: $(git rev-list --count HEAD) commit(s), .git $(du -sh .git | cut -f1)"

FROM scratch

ARG APOLLO_COMMIT
LABEL apollo.commit="$APOLLO_COMMIT"

COPY --from=libwallet /deps/apollo/libwallet /deps/apollo/libwallet
