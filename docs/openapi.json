{
  "openapi": "3.0.3",
  "info": {
    "title": "muun-wrapper API",
    "version": "1.1.0",
    "description": "API local para una wallet Muun headless. Todas las rutas salvo /healthz requieren un token Bearer."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Docker Compose local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "summary": "Consulta el estado del proceso",
        "responses": {
          "200": {
            "description": "Servicio disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/wallet/create": {
      "post": {
        "operationId": "createWallet",
        "summary": "Crea la wallet y reserva su primera dirección",
        "responses": {
          "201": {
            "$ref": "#/components/responses/WalletInfo"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/receive/address": {
      "get": {
        "operationId": "receiveAddress",
        "summary": "Reserva una dirección onchain nueva",
        "responses": {
          "200": {
            "$ref": "#/components/responses/WalletInfo"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/balance": {
      "get": {
        "operationId": "getBalance",
        "summary": "Obtiene el saldo gastable en satoshis",
        "responses": {
          "200": {
            "description": "Saldo disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/operations": {
      "get": {
        "operationId": "listOperations",
        "summary": "Lista las operaciones con estado normalizado y metadatos onchain",
        "responses": {
          "200": {
            "description": "Historial de operaciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Operation"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Cada fila conserva status de Houston y agrega paymentState, createdAt RFC3339, transactionId nullable y confirmations onchain."
      }
    },
    "/receive/invoice": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Crea una invoice BOLT11 para recibir Lightning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/invoices/{paymentHash}": {
      "get": {
        "operationId": "getInvoiceStatus",
        "summary": "Consulta si una invoice emitida ya fue pagada",
        "description": "Responde sólo por invoices que emitió esta wallet: un payment hash desconocido devuelve 404 en vez de un \"no pagado\" indefinido. La liquidación sale del preimage que publica Houston, que es la única prueba del pago. Es idempotente y no dispara sincronización.",
        "parameters": [
          {
            "name": "paymentHash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "description": "Payment hash de la invoice, 32 bytes en hexadecimal"
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la invoice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/send": {
      "post": {
        "operationId": "sendPayment",
        "summary": "Envía Bitcoin onchain o paga una invoice BOLT11",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operación creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "200": {
            "description": "Replay idempotente de una operación completada",
            "headers": {
              "Idempotent-Replay": {
                "schema": {
                  "type": "boolean",
                  "example": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "400": {
            "description": "Validación o fallo anterior al primer POST operations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "description": "La key sigue in_flight",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          },
          "422": {
            "description": "La key se reutilizó con otro destination o amountSatoshis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          },
          "502": {
            "description": "Fallo después del primer POST operations; no reintentar sin reconciliar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          },
          "503": {
            "description": "Sesión Houston inválida antes del primer POST operations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          }
        },
        "description": "Con idempotencyKey, un replay completado responde el mismo SendResult con 200 e Idempotent-Replay: true. Los errores después de POST operations se conservan como in_flight para no reintentar un pago posiblemente enviado."
      }
    },
    "/sync": {
      "post": {
        "operationId": "syncIncomingSwaps",
        "summary": "Liquida incoming swaps Lightning pendientes",
        "responses": {
          "200": {
            "description": "Resultado de la sincronización",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/recovery/setup": {
      "post": {
        "operationId": "setupRecovery",
        "summary": "Registra una recovery code y prepara el emergency kit",
        "description": "La recovery code no se persiste ni se incluye en la respuesta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoverySetupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recovery code registrada y kit preparado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverySetup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/recovery/kit": {
      "get": {
        "operationId": "getEmergencyKit",
        "summary": "Exporta el emergency kit configurado",
        "responses": {
          "200": {
            "description": "Material de recuperación cifrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyKit"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Obtiene una operación con el mismo shape normalizado del listado",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación con status crudo, paymentState, createdAt, transactionId nullable y confirmations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationDetail"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/send/preview": {
      "post": {
        "operationId": "previewSendPayment",
        "summary": "Cotiza un envío sin firmar ni publicar",
        "description": "Para onchain, destination es opcional y el wrapper usa un output P2TR sintético para el cálculo. Para Lightning destination es obligatorio y debe ser una invoice BOLT11 con el mismo monto.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendPreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cotización actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/send/status/{key}": {
      "get": {
        "operationId": "getSendStatus",
        "summary": "Consulta el estado persistente de una idempotency key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado local del envío",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "No existe un registro para la key; los consumidores usan code=idempotency_key_not_found como capability check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                },
                "example": {
                  "error": "unknown idempotency key",
                  "code": "idempotency_key_not_found"
                }
              }
            }
          }
        }
      }
    },
    "/send/reconcile/{key}": {
      "post": {
        "operationId": "reconcileSend",
        "summary": "Reconcilia una key in_flight contra el historial de Houston",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la key después de reconciliar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "description": "Houston no expone requestId; la key queda in_flight para evitar un duplicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          },
          "409": {
            "description": "Hay un send activo con esta key; la reconciliación no modifica el registro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque token"
      }
    },
    "responses": {
      "WalletInfo": {
        "description": "Dirección reservada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WalletInfo"
            }
          }
        }
      },
      "Error": {
        "description": "Error de la API",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "WalletInfo": {
        "type": "object",
        "required": [
          "Address",
          "AddressIndex"
        ],
        "properties": {
          "Address": {
            "type": "string",
            "description": "Dirección Bitcoin Taproot"
          },
          "AddressIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "satoshis"
        ],
        "properties": {
          "satoshis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "InvoiceRequest": {
        "type": "object",
        "properties": {
          "amountSatoshis": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "invoice",
          "paymentHash"
        ],
        "properties": {
          "invoice": {
            "type": "string",
            "description": "Invoice BOLT11"
          },
          "paymentHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Clave para consultar el pago en GET /invoices/{paymentHash}"
          },
          "amountSatoshis": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "SendRequest": {
        "type": "object",
        "required": [
          "destination",
          "amountSatoshis"
        ],
        "properties": {
          "destination": {
            "type": "string",
            "description": "Dirección Bitcoin o invoice BOLT11 con monto fijo"
          },
          "amountSatoshis": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "description": "Key persistente opcional para deduplicar un envío."
          }
        }
      },
      "SendResult": {
        "type": "object",
        "required": [
          "operationId",
          "transactionId",
          "amountSatoshis",
          "feeSatoshis"
        ],
        "properties": {
          "operationId": {
            "type": "integer",
            "format": "int64"
          },
          "transactionId": {
            "type": "string",
            "description": "Hash onchain, vacío si Houston financia el swap"
          },
          "amountSatoshis": {
            "type": "integer",
            "format": "int64",
            "description": "Monto solicitado al destinatario, sin comisión, tanto para onchain como Lightning. POST /send/reconcile y GET /send/status repiten esta misma semántica."
          },
          "feeSatoshis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Comisión del envío, separada de amountSatoshis."
          },
          "paymentHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Payment hash de una invoice Lightning saliente."
          }
        }
      },
      "SyncResult": {
        "type": "object",
        "required": [
          "fulfilledIncomingSwaps"
        ],
        "properties": {
          "fulfilledIncomingSwaps": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RecoverySetupRequest": {
        "type": "object",
        "required": [
          "recoveryCode"
        ],
        "properties": {
          "recoveryCode": {
            "type": "string",
            "description": "Recovery code generada por el CLI"
          }
        }
      },
      "RecoverySetup": {
        "type": "object",
        "required": [
          "recoveryCodeChecksum",
          "verificationCode"
        ],
        "properties": {
          "recoveryCodeChecksum": {
            "type": "string"
          },
          "verificationCode": {
            "type": "string"
          }
        }
      },
      "EmergencyKit": {
        "type": "object",
        "required": [
          "version",
          "firstEncryptedKey",
          "firstFingerprint",
          "secondEncryptedKey",
          "secondFingerprint",
          "recoveryCodeChecksum",
          "verificationCode",
          "html",
          "metadata"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "example": 3
          },
          "firstEncryptedKey": {
            "type": "string",
            "description": "Clave de usuario cifrada por la recovery code"
          },
          "firstFingerprint": {
            "type": "string"
          },
          "secondEncryptedKey": {
            "type": "string",
            "description": "Clave de Muun cifrada por la recovery code"
          },
          "secondFingerprint": {
            "type": "string"
          },
          "recoveryCodeChecksum": {
            "type": "string"
          },
          "verificationCode": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "description": "Emergency kit imprimible"
          },
          "metadata": {
            "type": "string",
            "description": "Metadata para adjuntar al PDF"
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "id",
          "status",
          "paymentState",
          "createdAt",
          "amountSatoshis",
          "feeSatoshis",
          "confirmations",
          "transactionId"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "direction": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Estado crudo informado por Houston."
          },
          "paymentState": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "failed",
              "expired"
            ],
            "description": "Estado normalizado a partir de status."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "creationDate de Houston, normalizada a RFC3339 UTC."
          },
          "amountSatoshis": {
            "type": "integer",
            "format": "int64"
          },
          "feeSatoshis": {
            "type": "integer",
            "format": "int64"
          },
          "confirmations": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Confirmaciones onchain de Houston; 0 para Lightning."
          },
          "transactionId": {
            "type": "string",
            "description": "Txid onchain de Houston; null para Lightning o cuando Houston todavía no informa una transacción.",
            "nullable": true
          },
          "receiverAddress": {
            "type": "string",
            "description": "Dirección receptora informada por Houston para la operación onchain cuando está disponible."
          },
          "paymentHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Sólo en incoming swaps Lightning. Correlaciona la operación con su invoice."
          },
          "preimage": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Sólo en incoming swaps Lightning liquidados. Su presencia prueba el pago."
          }
        }
      },
      "InvoiceStatus": {
        "type": "object",
        "required": [
          "paymentHash",
          "state",
          "settled",
          "amountSatoshis"
        ],
        "properties": {
          "paymentHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "receiving",
              "settled"
            ],
            "description": "pending: la invoice es de esta wallet y Houston no reporta pago. receiving: el pago llegó pero su incoming swap no está liquidado, así que no hay preimage y los fondos no son gastables; el poller lo liquida cada MUUN_WRAPPER_SYNC_INTERVAL, o se fuerza con POST /sync. settled: el preimage prueba el pago."
          },
          "settled": {
            "type": "boolean",
            "description": "true sólo en el estado settled"
          },
          "preimage": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Presente sólo cuando settled es true"
          },
          "amountSatoshis": {
            "type": "integer",
            "format": "int64",
            "description": "Monto que pidió la invoice"
          },
          "receivedSatoshis": {
            "type": "integer",
            "format": "int64",
            "description": "Monto que reporta Houston. Comparalo con amountSatoshis."
          },
          "operationId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
