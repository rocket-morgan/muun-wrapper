{
  "openapi": "3.0.3",
  "info": {
    "title": "muun-wrapper API",
    "version": "1.0.0",
    "description": "API local para una wallet Muun headless. Todas las rutas salvo /healthz requieren un token Bearer."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Docker Compose local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "summary": "Consulta el estado del proceso",
        "responses": {
          "200": {
            "description": "Servicio disponible",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/wallet/create": {
      "post": {
        "operationId": "createWallet",
        "summary": "Crea la wallet y reserva su primera dirección",
        "responses": {
          "201": { "$ref": "#/components/responses/WalletInfo" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/receive/address": {
      "get": {
        "operationId": "receiveAddress",
        "summary": "Reserva una dirección onchain nueva",
        "responses": {
          "200": { "$ref": "#/components/responses/WalletInfo" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/balance": {
      "get": {
        "operationId": "getBalance",
        "summary": "Obtiene el saldo gastable en satoshis",
        "responses": {
          "200": {
            "description": "Saldo disponible",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Balance" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/operations": {
      "get": {
        "operationId": "listOperations",
        "summary": "Lista las operaciones de la wallet",
        "responses": {
          "200": {
            "description": "Historial de operaciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Operation" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/receive/invoice": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Crea una invoice BOLT11 para recibir Lightning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvoiceRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice creada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/invoices/{paymentHash}": {
      "get": {
        "operationId": "getInvoiceStatus",
        "summary": "Consulta si una invoice emitida ya fue pagada",
        "description": "Responde sólo por invoices que emitió esta wallet: un payment hash desconocido devuelve 404 en vez de un \"no pagado\" indefinido. La liquidación sale del preimage que publica Houston, que es la única prueba del pago. Es idempotente y no dispara sincronización.",
        "parameters": [
          {
            "name": "paymentHash",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "description": "Payment hash de la invoice, 32 bytes en hexadecimal"
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la invoice",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoiceStatus" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/send": {
      "post": {
        "operationId": "sendPayment",
        "summary": "Envía Bitcoin onchain o paga una invoice BOLT11",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operación creada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sync": {
      "post": {
        "operationId": "syncIncomingSwaps",
        "summary": "Liquida incoming swaps Lightning pendientes",
        "responses": {
          "200": {
            "description": "Resultado de la sincronización",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SyncResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/recovery/setup": {
      "post": {
        "operationId": "setupRecovery",
        "summary": "Registra una recovery code y prepara el emergency kit",
        "description": "La recovery code no se persiste ni se incluye en la respuesta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecoverySetupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recovery code registrada y kit preparado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecoverySetup" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/recovery/kit": {
      "get": {
        "operationId": "getEmergencyKit",
        "summary": "Exporta el emergency kit configurado",
        "responses": {
          "200": {
            "description": "Material de recuperación cifrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyKit" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque token"
      }
    },
    "responses": {
      "WalletInfo": {
        "description": "Dirección reservada",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/WalletInfo" }
          }
        }
      },
      "Error": {
        "description": "Error de la API",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "example": "ok" } }
      },
      "WalletInfo": {
        "type": "object",
        "required": ["Address", "AddressIndex"],
        "properties": {
          "Address": { "type": "string", "description": "Dirección Bitcoin Taproot" },
          "AddressIndex": { "type": "integer", "minimum": 0 }
        }
      },
      "Balance": {
        "type": "object",
        "required": ["satoshis"],
        "properties": { "satoshis": { "type": "integer", "format": "int64", "minimum": 0 } }
      },
      "InvoiceRequest": {
        "type": "object",
        "properties": {
          "amountSatoshis": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "Invoice": {
        "type": "object",
        "required": ["invoice", "paymentHash"],
        "properties": {
          "invoice": { "type": "string", "description": "Invoice BOLT11" },
          "paymentHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "Clave para consultar el pago en GET /invoices/{paymentHash}" },
          "amountSatoshis": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "SendRequest": {
        "type": "object",
        "required": ["destination", "amountSatoshis"],
        "properties": {
          "destination": { "type": "string", "description": "Dirección Bitcoin o invoice BOLT11 con monto fijo" },
          "amountSatoshis": { "type": "integer", "format": "int64", "minimum": 1 },
          "description": { "type": "string" }
        }
      },
      "SendResult": {
        "type": "object",
        "required": ["operationId", "transactionId", "amountSatoshis", "feeSatoshis"],
        "properties": {
          "operationId": { "type": "integer", "format": "int64" },
          "transactionId": { "type": "string", "description": "Hash onchain, vacío si Houston financia el swap" },
          "amountSatoshis": { "type": "integer", "format": "int64" },
          "feeSatoshis": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "SyncResult": {
        "type": "object",
        "required": ["fulfilledIncomingSwaps"],
        "properties": { "fulfilledIncomingSwaps": { "type": "integer", "minimum": 0 } }
      },
      "RecoverySetupRequest": {
        "type": "object",
        "required": ["recoveryCode"],
        "properties": {
          "recoveryCode": { "type": "string", "description": "Recovery code generada por el CLI" }
        }
      },
      "RecoverySetup": {
        "type": "object",
        "required": ["recoveryCodeChecksum", "verificationCode"],
        "properties": {
          "recoveryCodeChecksum": { "type": "string" },
          "verificationCode": { "type": "string" }
        }
      },
      "EmergencyKit": {
        "type": "object",
        "required": ["version", "firstEncryptedKey", "firstFingerprint", "secondEncryptedKey", "secondFingerprint", "recoveryCodeChecksum", "verificationCode", "html", "metadata"],
        "properties": {
          "version": { "type": "integer", "example": 3 },
          "firstEncryptedKey": { "type": "string", "description": "Clave de usuario cifrada por la recovery code" },
          "firstFingerprint": { "type": "string" },
          "secondEncryptedKey": { "type": "string", "description": "Clave de Muun cifrada por la recovery code" },
          "secondFingerprint": { "type": "string" },
          "recoveryCodeChecksum": { "type": "string" },
          "verificationCode": { "type": "string" },
          "html": { "type": "string", "description": "Emergency kit imprimible" },
          "metadata": { "type": "string", "description": "Metadata para adjuntar al PDF" }
        }
      },
      "Operation": {
        "type": "object",
        "required": ["id", "status", "amountSatoshis", "feeSatoshis", "confirmations"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "direction": { "type": "string" },
          "status": { "type": "string" },
          "amountSatoshis": { "type": "integer", "format": "int64" },
          "feeSatoshis": { "type": "integer", "format": "int64" },
          "confirmations": { "type": "integer", "format": "int64", "minimum": 0 },
          "transactionId": { "type": "string" },
          "receiverAddress": { "type": "string" },
          "paymentHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "Sólo en incoming swaps Lightning. Correlaciona la operación con su invoice." },
          "preimage": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "Sólo en incoming swaps Lightning liquidados. Su presencia prueba el pago." }
        }
      },
      "InvoiceStatus": {
        "type": "object",
        "required": ["paymentHash", "state", "settled", "amountSatoshis"],
        "properties": {
          "paymentHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "state": {
            "type": "string",
            "enum": ["pending", "receiving", "settled"],
            "description": "pending: la invoice es de esta wallet y Houston no reporta pago. receiving: el pago llegó pero su incoming swap no está liquidado, así que no hay preimage y los fondos no son gastables; el poller lo liquida cada MUUN_WRAPPER_SYNC_INTERVAL, o se fuerza con POST /sync. settled: el preimage prueba el pago."
          },
          "settled": { "type": "boolean", "description": "true sólo en el estado settled" },
          "preimage": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "Presente sólo cuando settled es true" },
          "amountSatoshis": { "type": "integer", "format": "int64", "description": "Monto que pidió la invoice" },
          "receivedSatoshis": { "type": "integer", "format": "int64", "description": "Monto que reporta Houston. Comparalo con amountSatoshis." },
          "operationId": { "type": "integer", "format": "int64" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
